{
  "name": "yt-evidence-capture",
  "version": "1.0.0",
  "description": "Obsidian plugin to capture YouTube evidence clips with transcript and metadata.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
