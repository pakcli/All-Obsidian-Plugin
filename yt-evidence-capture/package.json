  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.5.4"
  }
}
